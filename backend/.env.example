# ========================================================
# 1. CẤU HÌNH CƠ SỞ DỮ LIỆU MONGODB (QUAN TRỌNG NHẤT)
# ========================================================
# 👉 Chỉ việc dán chuỗi kết nối MongoDB của bạn vào bên dưới:
#
# - Dùng MongoDB Local trên máy (qua MongoDB Compass / mongod):
#   MONGO_URI=mongodb://127.0.0.1:27017/freedom_blog
#
# - Hoặc dùng MongoDB Atlas (Cloud online):
#   MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/freedom_blog?retryWrites=true&w=majority

MONGO_URI=mongodb://127.0.0.1:27017/freedom_blog


# ========================================================
# 2. CẤU HÌNH MÁY CHỦ BACKEND & FRONTEND
# ========================================================
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Khóa bí mật mã hóa phiên đăng nhập (JWT)
JWT_SECRET=you_cant_stop_here_secret_key_2026_super_secure


# ========================================================
# 3. CẤU HÌNH LƯU TRỮ HÌNH ẢNH (CLOUDINARY)
# ========================================================
# Đăng ký miễn phí tại https://cloudinary.com để lấy các khóa bên dưới:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
